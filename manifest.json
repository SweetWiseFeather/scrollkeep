{
  "manifest_version": 3,
  "name": "ScrollKeep · 长页存档",
  "version": "0.3.1",
  "description": "后台滚动长网页，保存连续单页 PDF 和网页图片到同一文件夹。",
  "minimum_chrome_version": "118",
  "homepage_url": "https://github.com/SweetWiseFeather/scrollkeep",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "debugger",
    "scripting",
    "downloads",
    "offscreen",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "ScrollKeep · 导出长网页",
    "default_popup": "popup.html"
  }
}
